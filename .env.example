# Copie para .env e preencha com valores REAIS (o .env e ignorado pelo git).
# NUNCA faca commit do .env. Estes sao apenas placeholders.

# PostgreSQL connection string usada pelo Prisma
DATABASE_URL=postgresql://user:pass@host:5432/db

# Segredo de assinatura dos JWT (use um valor aleatorio, minimo 32 caracteres)
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# Servidor HTTP
PORT=3001
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Chave da API Anthropic (geracao de relatorios)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Chave da API Resend (envio de email) e remetente
RESEND_API_KEY=re_your-key-here
EMAIL_FROM=Your Name <onboarding@resend.dev>
